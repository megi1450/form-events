/** Form Events backend: public JSONP reads, token-protected admin POSTs and Google Sheets submissions. */
const SPREADSHEET_ID="1GDJU9_GMU9HpAH5ugxjkZKLxjjKufVH_g77b9e8ikGA";
const EVENTS_SHEET="Events", QUESTIONS_SHEET="Questions", RESPONSES_SHEET="Responses", TOKEN_KEY="FORM_EVENTS_ADMIN_TOKEN";
const EVENT_HEADERS=["Event ID","Title","Description","Status","Created At","Updated At","Published At"];
const QUESTION_HEADERS=["Event ID","Question ID","Order","Label","Type","Required","Options JSON","Placeholder","Help Text"];

function initializeBackend(){
 ensureSheet_(EVENTS_SHEET,EVENT_HEADERS);ensureSheet_(QUESTIONS_SHEET,QUESTION_HEADERS);ensureSheet_(RESPONSES_SHEET,["Submission ID","Submitted At","Event ID","Event Title"]);
 const props=PropertiesService.getScriptProperties();let token=props.getProperty(TOKEN_KEY);
 if(!token){token=Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");props.setProperty(TOKEN_KEY,token);console.log("ADMIN TOKEN (copy into the website Admin login; keep private): "+token);}
 else console.log("Tabs checked. Token already exists; run showAdminTokenForOwner if you need to retrieve it.");
 console.log("Prepared spreadsheet: "+SPREADSHEET_ID);return "Backend initialised. Check the execution log for the first-run admin token.";
}
function showAdminTokenForOwner(){const t=PropertiesService.getScriptProperties().getProperty(TOKEN_KEY);if(!t)throw new Error("Run initializeBackend first.");console.log("ADMIN TOKEN (private; do not publish): "+t);}
function doGet(e){try{const p=e?.parameter||{},a=String(p.action||"listEvents");let out;if(a==="listEvents")out={ok:true,events:listPublicEvents_()};else if(a==="getEvent"){const ev=getEvent_(String(p.id||""));out=ev&&ev.status==="Published"?{ok:true,event:publicEvent_(ev)}:{ok:false,error:"This form is not available."};}else out={ok:false,error:"Unsupported read action."};const json=JSON.stringify(out).replace(/</g,"\\u003c").replace(/>/g,"\\u003e").replace(/&/g,"\\u0026"),cb=String(p.callback||"");if(cb&&/^[A-Za-z_$][0-9A-Za-z_$.]*$/.test(cb))return ContentService.createTextOutput(cb+"("+json+");").setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message||err)})).setMimeType(ContentService.MimeType.JSON);}}
function doPost(e){let requestId="";try{if(!e?.parameter?.payload)throw new Error("Missing payload.");const p=JSON.parse(e.parameter.payload);requestId=String(p.requestId||"");let out;if(p.action==="submit")out=submitResponse_(p);else{requireAdmin_(p.token);if(p.action==="listAdmin")out={ok:true,events:listAdminEvents_()};else if(p.action==="saveEvent")out={ok:true,event:saveEvent_(p.event||{})};else if(p.action==="setStatus")out={ok:true,event:setStatus_(String(p.id||""),String(p.status||""))};else throw new Error("Unsupported action.");}return htmlReply_(requestId,out||{ok:true});}catch(err){return htmlReply_(requestId,{ok:false,error:String(err.message||err)});}}
function htmlReply_(requestId,data){const payload=JSON.stringify({source:"form-events-backend",requestId:String(requestId||""),data:data||{ok:true}}).replace(/</g,"\\u003c").replace(/>/g,"\\u003e").replace(/&/g,"\\u0026");return HtmlService.createHtmlOutput('<!doctype html><html><body><script>window.top.postMessage('+payload+',"https://megi1450.github.io");</script></body></html>').setTitle("Form Events response").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function requireAdmin_(candidate){const saved=PropertiesService.getScriptProperties().getProperty(TOKEN_KEY);if(!saved||!candidate||!constantTimeEqual_(String(candidate),String(saved)))throw new Error("Admin token is incorrect or backend is not initialised.");}
function constantTimeEqual_(a,b){if(a.length!==b.length)return false;let d=0;for(let i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0;}
function book_(){return SpreadsheetApp.openById(SPREADSHEET_ID);}
function ensureSheet_(name,headers){const ss=book_();let sh=ss.getSheetByName(name);if(!sh&&name===EVENTS_SHEET&&ss.getSheets().length===1&&ss.getSheets()[0].getName()==="Sheet1"){sh=ss.getSheets()[0];sh.setName(name);}if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]);else{const old=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0];if(old.every(v=>v===""))sh.getRange(1,1,1,headers.length).setValues([headers]);else if(name===RESPONSES_SHEET){const missing=headers.filter(h=>old.indexOf(h)<0);if(missing.length)sh.getRange(1,old.length+1,1,missing.length).setValues([missing]);}}sh.setFrozenRows(1);sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).setFontWeight("bold").setBackground("#201b3d").setFontColor("#ffffff").setWrap(true);return sh;}
function objects_(name){const sh=book_().getSheetByName(name);if(!sh||sh.getLastRow()<2)return [];const values=sh.getDataRange().getValues(),heads=values.shift().map(String);return values.filter(r=>r.some(v=>v!=="")).map(r=>{const o={};heads.forEach((h,i)=>o[h]=r[i]);return o;});}
function dateText_(d){if(!d)return "";return d instanceof Date?Utilities.formatDate(d,Session.getScriptTimeZone(),"dd MMM yyyy, HH:mm"):String(d);}
function readQuestions_(){return objects_(QUESTIONS_SHEET).map(o=>{let opts=[];try{opts=JSON.parse(String(o["Options JSON"]||"[]"));}catch(ignore){}return{eventId:String(o["Event ID"]||""),id:String(o["Question ID"]||""),order:Number(o["Order"]||0),label:String(o["Label"]||""),type:String(o["Type"]||"short"),required:String(o["Required"]).toLowerCase()==="true"||o["Required"]===true,options:Array.isArray(opts)?opts:[],placeholder:String(o["Placeholder"]||""),helpText:String(o["Help Text"]||"")};});}
function questionsFor_(id){return readQuestions_().filter(q=>q.eventId===id).sort((a,b)=>a.order-b.order).map(q=>{const x={...q};delete x.eventId;delete x.order;return x;});}
function readEvents_(){return objects_(EVENTS_SHEET).map(o=>({id:String(o["Event ID"]||""),title:String(o["Title"]||""),description:String(o["Description"]||""),status:String(o["Status"]||"Draft"),createdAt:dateText_(o["Created At"]),updatedAt:dateText_(o["Updated At"]),publishedAt:dateText_(o["Published At"]),questions:questionsFor_(String(o["Event ID"]||""))})).filter(e=>e.id);}
function getEvent_(id){return readEvents_().find(e=>e.id===id)||null;}
function publicEvent_(e){return{id:e.id,title:e.title,description:e.description,questions:e.questions.map(q=>({id:q.id,label:q.label,type:q.type,required:q.required,options:q.options,placeholder:q.placeholder,helpText:q.helpText})),questionCount:e.questions.length,status:e.status};}
function listPublicEvents_(){return readEvents_().filter(e=>e.status==="Published").map(e=>({id:e.id,title:e.title,description:e.description,questionCount:e.questions.length,status:e.status,updatedAt:e.updatedAt}));}
function listAdminEvents_(){return readEvents_().sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt)));}
function saveEvent_(input){
 const title=String(input.title||"").trim();if(!title)throw new Error("A form title is required.");
 const status=["Draft","Published","Archived"].includes(input.status)?input.status:"Draft";
 const incoming=Array.isArray(input.questions)?input.questions:[];
 if(status==="Published"&&!incoming.length)throw new Error("Add at least one question before publishing.");
 const allowed=["short","paragraph","email","number","dropdown","radio","checkbox","date","yesno"];
 const qRows=incoming.map((q,i)=>{
  const label=String(q.label||"").trim(),type=String(q.type||"short");
  if(!label)throw new Error("Every question must have a label.");
  if(!allowed.includes(type))throw new Error("Unsupported question type: "+type);
  const options=Array.isArray(q.options)?q.options.map(v=>String(v).trim()).filter(Boolean):[];
  if(["dropdown","radio","checkbox"].includes(type)&&options.length<2)throw new Error('Question "'+label+'" needs at least two choices.');
  return [String(input.id||""),String(q.id||("q_"+Utilities.getUuid().slice(0,8))),i+1,label,type,Boolean(q.required),JSON.stringify(options),String(q.placeholder||""),String(q.helpText||"")];
 });
 const id=String(input.id||"").trim()||("ev_"+Utilities.getUuid().replace(/-/g,"").slice(0,12)),now=new Date(),existing=getEvent_(id);
 qRows.forEach(r=>r[0]=id);
 const publishedAt=status==="Published"?(existing&&existing.publishedAt?existing.publishedAt:now):(existing?existing.publishedAt:"");
 const row=[id,title,String(input.description||"").trim(),status,existing?existing.createdAt:now,now,publishedAt];
 const sh=ensureSheet_(EVENTS_SHEET,EVENT_HEADERS),values=sh.getDataRange().getValues(),heads=values[0].map(String),idCol=heads.indexOf("Event ID");let at=-1;
 for(let i=1;i<values.length;i++)if(String(values[i][idCol])===id){at=i+1;break;}
 sh.getRange(at>0?at:sh.getLastRow()+1,1,1,row.length).setValues([row]);
 const qs=ensureSheet_(QUESTIONS_SHEET,QUESTION_HEADERS);
 for(let i=qs.getLastRow();i>=2;i--)if(String(qs.getRange(i,1).getValue())===id)qs.deleteRow(i);
 if(qRows.length)qs.getRange(qs.getLastRow()+1,1,qRows.length,QUESTION_HEADERS.length).setValues(qRows);
 const out=getEvent_(id);return{id:out.id,title:out.title,description:out.description,status:out.status,createdAt:out.createdAt,updatedAt:out.updatedAt,publishedAt:out.publishedAt,questions:out.questions};
}
function setStatus_(id,status){if(!["Draft","Published","Archived"].includes(status))throw new Error("Invalid form status.");if(status==="Published"){const ev=getEvent_(id);if(!ev)throw new Error("Form not found.");if(!ev.questions.length)throw new Error("Add at least one question before publishing.");}const sh=book_().getSheetByName(EVENTS_SHEET);if(!sh)throw new Error("Events sheet is missing.");const data=sh.getDataRange().getValues(),heads=data[0].map(String),idCol=heads.indexOf("Event ID"),stCol=heads.indexOf("Status"),upCol=heads.indexOf("Updated At"),pubCol=heads.indexOf("Published At");for(let i=1;i<data.length;i++)if(String(data[i][idCol])===id){sh.getRange(i+1,stCol+1).setValue(status);sh.getRange(i+1,upCol+1).setValue(new Date());if(status==="Published"&&!data[i][pubCol])sh.getRange(i+1,pubCol+1).setValue(new Date());return listAdminEvents_().find(e=>e.id===id);}throw new Error("Form not found.");}
function submitResponse_(p){const id=String(p.eventId||""),ev=getEvent_(id);if(!ev||ev.status!=="Published")throw new Error("This form is closed or no longer available.");const answers=p.answers&&typeof p.answers==="object"?p.answers:{},qs=ev.questions;qs.forEach(q=>{const v=answers[q.id],empty=v===undefined||v===null||v===""||(Array.isArray(v)&&!v.length);if(q.required&&empty)throw new Error('Please answer the required question: "'+q.label+'".');if(q.type==="email"&&!empty&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v)))throw new Error('Enter a valid email for "'+q.label+'".');if(q.type==="dropdown"&&!empty&&!q.options.includes(String(v)))throw new Error("Invalid choice for "+q.label+".");if(q.type==="radio"&&!empty&&!q.options.includes(String(v)))throw new Error("Invalid choice for "+q.label+".");if(q.type==="checkbox"&&!empty&&(!Array.isArray(v)||v.some(x=>!q.options.includes(String(x)))))throw new Error("Invalid choice for "+q.label+".");});
 const sh=ensureSheet_(RESPONSES_SHEET,["Submission ID","Submitted At","Event ID","Event Title"]),existing=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0].map(String),cols=qs.map(q=>({q,h:ev.title+" — "+q.label+" ["+q.id+"]"})),headers=existing.slice();cols.forEach(c=>{if(!headers.includes(c.h))headers.push(c.h);});if(headers.length>existing.length)sh.getRange(1,1,1,headers.length).setValues([headers]);const sub="sub_"+Utilities.getUuid().replace(/-/g,""),map={"Submission ID":sub,"Submitted At":new Date(),"Event ID":ev.id,"Event Title":safeCell_(ev.title)};cols.forEach(({q,h})=>{let v=answers[q.id];if(Array.isArray(v))v=v.join(" · ");map[h]=safeCell_(String(v??""));});const row=headers.map(h=>map[h]===undefined?"":map[h]);const writeAt=sh.getLastRow()+1;sh.getRange(writeAt,1,1,row.length).setValues([row]);sh.getRange(writeAt,2).setNumberFormat("yyyy-mm-dd hh:mm:ss");sh.getRange(1,1,1,headers.length).setFontWeight("bold").setBackground("#201b3d").setFontColor("#ffffff").setWrap(true);return{ok:true,submissionId:sub,message:"Response saved."};}
function safeCell_(v){const s=String(v==null?"":v);return/^[=+@\-]/.test(s)?"'"+s:s;}
